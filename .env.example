# Application Settings
APP_NAME="AI SQL Assistant"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Set DB_ENGINE="sqlite" for instant local setup, or "postgresql" for PostgreSQL
DB_ENGINE=sqlite
DATABASE_URL=sqlite:///./ai_sql_assistant.db

# PostgreSQL example:
# DB_ENGINE=postgresql
# DATABASE_URL=postgresql://read_only_user:read_only_pass@localhost:5432/ai_sql_db

# Query Execution Safety Limits
QUERY_TIMEOUT_SECONDS=5.0
MAX_QUERY_LIMIT=100

# LLM Provider Configuration
# Supported providers: "mock", "gemini", "openai"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash
